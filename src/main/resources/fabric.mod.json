{
	"schemaVersion": 1,
	"id": "coliseumod",
	"version": "${version}",
	"name": "Colosseum for cobblemon",
	"description": "Server-side automatic Cobblemon tournaments: timed queues, random rules, parallel arenas and loot pool rewards.",
	"authors": [
		"Thesatiru"
	],
	"contact": {
		"homepage": "https://github.com/Thesatiru/Colosseum-Mod",
		"sources": "https://github.com/Thesatiru/Colosseum-Mod",
		"issues": "https://github.com/Thesatiru/Colosseum-Mod/issues"
	},
	"license": "MIT",
	"icon": "assets/coliseumod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "satiru.coliseumod.ColiseuMod",
				"adapter": "kotlin"
			}
		]
	},
	"depends": {
		"cobblemon": "*",
		"fabricloader": ">=0.16.0",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}